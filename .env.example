# Configuration Supabase
# Copiez ce fichier en .env.local pour le développement local

# Supabase Project URL (trouvable dans Dashboard Supabase > Settings > API)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon/Public Key (trouvable dans Dashboard Supabase > Settings > API)
SUPABASE_KEY=your-anon-key-here

# Supabase Service Role Key (optionnel, pour les opérations admin)
# ⚠️ NE JAMAIS exposer cette clé côté client !
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Emails autorisés à accéder aux pages/routes /admin/* (liste séparée par des virgules)
ADMIN_EMAILS=admin@example.com
